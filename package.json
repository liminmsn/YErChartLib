{
  "name": "y_er_chart",
  "version": "1.0.0",
  "description": "自用封装的er关系图表库",
  "type": "module",
  "main": "dist/chart-library.js",
  "module": "dist/chart-library.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rollup -c -w",
    "serve": "serve . -p 3000",
    "start": "npm-run-all --parallel dev serve",
    "clean": "rm -rf dist types",
    "build": "npm run clean && NODE_ENV=production rollup -c",
    "build:dev": "npm run clean && rollup -c",
    "analyze": "ANALYZE=true npm run build:dev",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^18.0.0",
    "cross-env": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "rollup": "^3.0.0",
    "rollup-plugin-visualizer": "^5.0.0",
    "serve": "^14.2.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vue-flow/core": "^1.46.0"
  }
}